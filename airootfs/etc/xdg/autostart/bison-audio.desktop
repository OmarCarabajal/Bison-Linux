[Desktop Entry]
Type=Application
Name=Bison Audio
Comment=Arranca PipeWire en live como root
Exec=/usr/local/bin/bison-live-audio.sh
OnlyShowIn=XFCE;
NoDisplay=true
X-GNOME-Autostart-enabled=true