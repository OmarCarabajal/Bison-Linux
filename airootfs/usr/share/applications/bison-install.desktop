[Desktop Entry]
Path=/root
Type=Application
Name=Instalar Bison
Comment=Instalar Bison Linux en tu disco
Exec=xfce4-terminal --maximize -e "bash -c 'cd /root; sudo bison-install'"
Icon=bison-install
Terminal=false
Categories=System;