#!/usr/bin/env bash
# BISON Live - modo prueba sin instalar

clear

systemctl start NetworkManager 2>/dev/null || true
sleep 1

unset DISPLAY

# ir al escritorio
bison-desktop

# volver
clear
cat /etc/motd

echo ""
echo -e "Para instalar Bison: \e[1;36mbison-install\e[0m"
echo -e "Probar live: \e[1;36mbison-live\e[0m"
echo ""
