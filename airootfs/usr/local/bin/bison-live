#!/usr/bin/env bash
# BISON Live - modo prueba sin instalar
# Autor: Omar Carabajal
# Fecha: 9/11/2026

# Este programa es software libre: puedes redistribuirlo y/o modificarlo 
# bajo los términos de la Licencia Pública General GNU (GPL) versión 3, 
